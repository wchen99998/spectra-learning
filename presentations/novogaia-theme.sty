% One shared page grid; zero padding keeps visible edges on their anchors.
\newcommand{\header}[2]{%
 \path[use as bounding box] (0,0) rectangle (16,9);
 \node[anchor=base west,inner sep=0,font=\fontsize{7.8}{10}\selectfont,text=muted] at (.75,8.35) {#1};
 \node[anchor=base east,inner sep=0,font=\brandmedium\fontsize{11}{12}\selectfont] (brandwordmark) at (15.25,8.35) {Novogaia};
 \node[anchor=east,inner sep=0] at ([xshift=-.12cm]brandwordmark.west) {\includegraphics[width=.32cm]{assets/novogaia-logo.pdf}};
 \node[anchor=north west,inner sep=0] at (.75,7.87) {\maxsizebox{14.5cm}{!}{\brandmedium\fontsize{20}{22}\selectfont #2}};
 \draw[line,line width=.45pt] (.75,.61)--(15.25,.61);
 \node[anchor=base east,inner sep=0,font=\fontsize{6.6}{8}\selectfont,text=muted] at (15.25,.24) {\insertframenumber};
}
\newcommand{\txt}[4]{\node[anchor=north west,align=left,text width=#3cm] at (#1,#2) {#4};}
\newcommand{\smalltxt}[4]{\node[anchor=north west,align=left,text width=#3cm,small] at (#1,#2) {#4};}
\newcommand{\eqn}[4][12]{\node[anchor=north west,font=\fontsize{#1}{15}\selectfont] at (#2,#3) {$\displaystyle #4$};}
\newcommand{\source}[1]{\node[anchor=south west,inner sep=0,align=left,text width=14.5cm,font=\fontsize{5.1}{5.8}\selectfont,text=muted] at (.75,.76) {#1};}
\newcommand{\takeaway}[1]{\draw[ink,line width=1pt] (.75,1.76)--(.75,1.24);\node[anchor=west,inner sep=0] at (1.0,1.5) {\maxsizebox{14.25cm}{!}{\brandmedium\fontsize{9.5}{11}\selectfont #1}};}
\newcommand{\diagramblock}[5]{\node[box,minimum width=#3cm,text width=#3cm,minimum height=#4cm] at (#1,#2) {#5};}
\newcommand{\spectrum}[3]{\begin{scope}[shift={(#1,#2)},scale=#3]
 \draw[muted,line width=.5pt] (0,0)--(3.6,0);\draw[muted,line width=.5pt] (0,0)--(0,1.9);
 \foreach \x/\h in {.25/.18,.49/.46,.68/1.42,.87/.37,1.08/.74,1.31/.31,1.57/1.78,1.76/.46,1.96/.19,2.17/1.1,2.37/.57,2.57/.31,2.88/.76,3.21/.23,3.4/.38}{\draw[ink,line width=.85pt] (\x,0)--(\x,\h);}
 \foreach \x in {.6,1.2,1.8,2.4,3.0}{\draw[ink,line width=.45pt] (\x,0)--+(0,-.06);}
 \foreach \y in {.45,.9,1.35,1.8}{\draw[ink,line width=.45pt] (0,\y)--+(-.06,0);}
 \foreach \x/\lab in {0/0,1.8/45,3.6/90}{\node[anchor=north,font=\figurefont\fontsize{5.5}{6}\selectfont] at (\x,-.08) {\lab};}
 \foreach \y/\lab in {0/0,.9/0.5,1.8/1.0}{\node[anchor=east,font=\figurefont\fontsize{5.5}{6}\selectfont] at (-.08,\y) {\lab};}
 \node[anchor=north east,font=\figurefont\fontsize{6.2}{7}\selectfont] at (3.6,-.45) {$m/z$ (Th)};
 \node[anchor=south west,font=\figurefont\fontsize{6.2}{7}\selectfont] at (0,1.96) {Relative intensity (a.u.)};
 \end{scope}}
\newcommand{\molecule}[3]{\begin{scope}[shift={(#1,#2)},scale=#3]
 \draw[ink,line width=1pt] (0,1)--(.866,.5)--(.866,-.5)--(0,-1)--(-.866,-.5)--(-.866,.5)--cycle;
 \draw[ink,line width=.7pt] (.68,.4)--(.68,-.4);\draw[ink,line width=.7pt] (-.7,-.44)--(-.02,-.83);\draw[ink,line width=.7pt] (-.7,.44)--(-.02,.83);
 \draw[ink,line width=1pt] (0,1)--(0,1.55);\node[font=\fontsize{12}{13}\selectfont] at (0,1.77) {OH};
 \end{scope}}
\newcommand{\peaktokens}[3]{\foreach \i in {0,...,5}{\pgfmathsetmacro{\xx}{#1+\i*.36}\draw[fill=#3,draw=ink,line width=.45pt] (\xx,#2) rectangle +(0.24,.6);}}
